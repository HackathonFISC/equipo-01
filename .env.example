# Copiar a .env y llenar con claves propias. Nunca subir .env al repo.

# Claude (modelo principal, capa común puente/llm.py, issue #45)
ANTHROPIC_API_KEY=
# Solo si la clave no es de un workspace (empieza con sk-ant-usr-): el ID del workspace, wrkspc_...
ANTHROPIC_WORKSPACE_ID=
# anthropic (por defecto) o gemini
LLM_PROVEEDOR=anthropic
# Vacío: llm.py usa claude-opus-5-5 con anthropic y gemini-2.5-flash con gemini.
PUENTE_MODELO_LLM=
# vivo | grabar | reproducir. Sin la variable, el código usa vivo; para la demo sin red y la CI, poner
# reproducir (sin red ni claves). Usar vivo o grabar solo cuando se necesite
LLM_MODO=reproducir
# Carpeta de grabaciones (opcional; por defecto data/grabaciones)
LLM_DIR_GRABACIONES=
# Respaldo ante un rechazo del modelo (opcionales): proveedor y modelo del segundo intento
LLM_PROVEEDOR_RESPALDO=
LLM_MODELO_RESPALDO=
# Respaldo del servidor de Anthropic (beta, sin verificar con clave; dejar en false)
PUENTE_LLM_FALLBACKS=false
# Límite estimado de gasto (US$) en llamadas reales por proceso; reproducir no consume. Vacío = sin tope local.
# Para grabar evals, 2 basta. En el tablero de la demo (un proceso largo), dejarlo vacío o alto (p. ej. 20):
# el límite de gasto del workspace en la consola de Anthropic ya protege el crédito.
PUENTE_LLM_TOPE_USD=

# Gemini (Google AI Studio): respaldo opcional con LLM_PROVEEDOR=gemini
GOOGLE_API_KEY=

# Trazas en LangSmith
LANGSMITH_API_KEY=
# false por defecto: la demo sin red no intenta mandar trazas. Ponerlo en true solo con clave y conexión.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=puente
# No guardar entradas ni salidas en las trazas (datos personales, #56)
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Bot de Telegram de la demo (sin token, los mensajes se escriben en outbox/)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_EMPRESA=
# Chat de cada joven (#12), uno por persona: perfil_id=chat_id separados por comas (ej. yaritza=123456).
# Quien no esté aquí recibe su mensaje en outbox/joven_<perfil_id>_*.txt; nunca va a un chat compartido ni al de la empresa
TELEGRAM_CHATS_JOVENES=

# Chatbot de WhatsApp del joven por Twilio Sandbox (#160; solo para demo, número compartido de Twilio).
# Sin TWILIO_AUTH_TOKEN, POST /api/whatsapp responde 503; sin cuenta o sin red, lo que el bot manda por su
# cuenta (el «perfil listo») queda en outbox/whatsapp_<hash>_*.txt. El número del joven nunca se guarda en claro.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública del servidor tal como la ve Twilio, sin barra final (ej. https://xxxx.trycloudflare.com).
# La firma X-Twilio-Signature se calcula sobre esa URL + /api/whatsapp; vacía, se reconstruye con
# X-Forwarded-Proto y Host. Cambia cada vez que se abre un túnel rápido nuevo de cloudflared.
PUBLIC_BASE_URL=

# Alternativa gratis a Twilio (#160): el número de prueba de Meta (WhatsApp Cloud API), webhook /api/whatsapp/meta.
# developers.facebook.com > tu app > WhatsApp > API Setup: token temporal (dura 24 h) y Phone number ID;
# App settings > Basic: App secret (firma X-Hub-Signature-256). El verify token lo eliges tú y lo repites en Meta.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Versión de la Graph API (por defecto v23.0); usa la del curl de ejemplo de API Setup si es otra.
META_GRAPH_VERSION=

# Herramientas de Postulación (#7)
# Ruta de la base SQLite (por defecto puente.db; *.db está en .gitignore)
PUENTE_DB=
# Checkpoints del grafo, en un archivo aparte de puente.db (por defecto el de puente/graph.py)
PUENTE_CHECKPOINTS=
# Carpeta del CV ciego, el .ics y los mensajes que no salen por Telegram (por defecto outbox/, en .gitignore).
# La demo `python -m puente.graph` no usa Telegram salvo con --telegram, aunque arriba haya token y chats.
PUENTE_OUTBOX=
# Fecha y hora propuestas para la entrevista, ISO 8601 con zona (ej. 2026-10-20T10:00:00-05:00).
# Vacío: mañana a las 10:00 hora de Panamá, marcada como "Fecha provisional, por confirmar con la empresa".
PUENTE_ENTREVISTA_INICIO=

# Clave del HMAC del código anónimo del scorecard (#158). Vacía: una al azar por proceso, el código cambia al reiniciar.
PUENTE_SAL_ANONIMO=
