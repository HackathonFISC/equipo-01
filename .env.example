# Copiar a .env y llenar con claves propias. Nunca subir .env al repo.

# Gemini (Google AI Studio)
GOOGLE_API_KEY=

# Trazas en LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=puente

# Bot de Telegram de la demo (sin token, los mensajes se escriben en outbox/)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_EMPRESA=

# Herramientas de Postulación (#7)
# Ruta de la base SQLite (por defecto puente.db; *.db está en .gitignore)
PUENTE_DB=
# Fecha y hora propuestas para la entrevista, ISO 8601 con zona (ej. 2026-10-20T10:00:00-05:00).
# Vacío: mañana a las 10:00 hora de Panamá, marcada como "Fecha provisional, por confirmar con la empresa".
PUENTE_ENTREVISTA_INICIO=
